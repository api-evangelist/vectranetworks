        {
          "info": {
            "name": "Retrieve single account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{fqdn}/api/{apiVersion}/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
