{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vectra Detect Accounts Lockdown API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "authorization",
      "value": "{{authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lockdown",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve entities in lockdown mode",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{fqdn}/api/{apiVersion}/lockdown"
          },
          "docs": "Retrieve entities in lockdown mode"
        }
      ]
    }
  ],
  "bundled": true
}