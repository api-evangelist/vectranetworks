{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vectra Detect Accounts Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "authorization",
      "value": "{{authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve health data of the appliance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{fqdn}/api/{apiVersion}/health"
          },
          "docs": "Retrieve health data of the appliance"
        }
      ]
    }
  ],
  "bundled": true
}